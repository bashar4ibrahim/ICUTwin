# App
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
INVITE_TOKEN_SECRET=your-invite-token-secret-change-this

# Email (choose one option)

# Option 1: Mailtrap (for testing - free at mailtrap.io)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="DocuSign Platform <noreply@docusign.local>"

# Option 2: Gmail (use App Password from Google Account > Security > 2FA > App Passwords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="DocuSign Platform <your.email@gmail.com>"

# Option 3: Resend (free tier - get API key at resend.com)
# RESEND_API_KEY=re_xxxxxxxxxx
# SMTP_FROM="DocuSign Platform <onboarding@resend.dev>"
